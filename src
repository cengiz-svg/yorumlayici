#include <iostream>
#include <vector>
#include <map>
#include <string>
#include <cctype>
#include <cstdlib>
using namespace std;

enum Tok {
    NUM, STR, BOOL, ID,
    LET, PRINT, IF, ELSE, WHILE,
    PLUS, MINUS, MUL, DIV,
    ASSIGN, EQ, NE, LT, GT, LE, GE,
    LP, RP, LB, RB, SEMI, END
};

struct Token {
    Tok type;
    string text;
};

vector<Token> tokens;
int pos = 0;

void error(string msg) {
    cout << "Syntax Error: " << msg << endl;
    exit(1);
}

void add(Tok t, string s = "") {
    tokens.push_back({ t, s });
}

void lexer(string code) {
    int i = 0;

    while (i < code.size()) {
        if (isspace(code[i])) {
            i++;
            continue;
        }

        if (isdigit(code[i])) {
            string n;
            while (i < code.size() && isdigit(code[i]))
                n += code[i++];

            add(NUM, n);
            continue;
        }

        if (isalpha(code[i]) || code[i] == '_') {
            string w;
            while (i < code.size() && (isalnum(code[i]) || code[i] == '_'))
                w += code[i++];

            if (w == "let") add(LET);
            else if (w == "print") add(PRINT);
            else if (w == "if") add(IF);
            else if (w == "else") add(ELSE);
            else if (w == "while") add(WHILE);
            else if (w == "true" || w == "false") add(BOOL, w);
            else add(ID, w);

            continue;
        }

        if (code[i] == '"') {
            i++;
            string s;

            while (i < code.size() && code[i] != '"')
                s += code[i++];

            if (i >= code.size()) error("string kapanmadi");

            i++;
            add(STR, s);
            continue;
        }

        if (code[i] == '=' && code[i + 1] == '=') {
            add(EQ); i += 2; continue;
        }

        if (code[i] == '!' && code[i + 1] == '=') {
            add(NE); i += 2; continue;
        }

        if (code[i] == '<' && code[i + 1] == '=') {
            add(LE); i += 2; continue;
        }

        if (code[i] == '>' && code[i + 1] == '=') {
            add(GE); i += 2; continue;
        }

        char c = code[i++];

        if (c == '+') add(PLUS);
        else if (c == '-') add(MINUS);
        else if (c == '*') add(MUL);
        else if (c == '/') add(DIV);
        else if (c == '=') add(ASSIGN);
        else if (c == '<') add(LT);
        else if (c == '>') add(GT);
        else if (c == '(') add(LP);
        else if (c == ')') add(RP);
        else if (c == '{') add(LB);
        else if (c == '}') add(RB);
        else if (c == ';') add(SEMI);
        else error("bilinmeyen karakter");
    }

    add(END);
}
